DATABASE_URL="file:../../packages/db/prisma/dev.db"

# MUST be the same value as the attendee app's NEXTAUTH_SECRET.
#
# It signs this app's sessions, and it is also what the attendee app checks when
# this app tells it a company's details have changed (see ATTENDEE_APP_URL
# below). If the two differ, the attendee app answers {"error":"Invalid secret"}
# and every invalidation is refused. Measured 2026-08-02: the four apps on one
# development machine held three different values, so this had never worked
# locally. Findings F-16 and F-17.
NEXTAUTH_SECRET="run: openssl rand -base64 32"

NEXTAUTH_URL="http://localhost:3003"

# Where the attendee app lives, so this app can tell it that a company's
# booth-card details have changed.
#
# Required in production. Phase 9 moved tagline, website, logo, booth number and
# offerings into the attendee app's cached venue-map payload, so a representative
# editing their profile here changes what a delegate sees on the booth card —
# finding F-13. Unset, this falls back to localhost:3001, which in production
# means the request goes nowhere: the edit saves, a warning is logged, and
# delegates keep the old details until the cache expires.
#
# Added 2026-08-02 after Phase 10's adversarial review pointed out that the
# sponsor app had gained this dependency without gaining a way to configure it.
#
# Local: http://localhost:3001
# Production: the attendee app's own address, e.g. https://wbr-mobile.vercel.app
ATTENDEE_APP_URL="http://localhost:3001"
OPENAI_API_KEY="" # for sponsor-side intro draft (Phase 12a)
WBR_AI_SPONSOR_DRAFT_INTRO_ENABLED="" # feature flag: "true" to enable the AI intro draft surface
NEXT_PUBLIC_WBR_AI_SPONSOR_DRAFT_INTRO_ENABLED="" # client mirror of the feature flag
