DATABASE_URL="file:../../packages/db/prisma/dev.db"
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# "Sign in with LinkedIn" (Phase 12). Optional: leave both empty and the button
# is not drawn, while email and Google sign-in work unchanged.
#
# To fill them in: create an application at https://www.linkedin.com/developers/apps/new,
# associate it with a LinkedIn Page and have that Page's super administrator approve
# the association, then enable the "Sign in with LinkedIn using OpenID Connect"
# product on the Products tab. That product is self-serve and needs no review.
#
# Register both return addresses on the Auth tab, exactly:
#   http://localhost:3001/api/auth/callback/linkedin
#   https://wbr-mobile.vercel.app/api/auth/callback/linkedin
#
# Both values must be set. One alone leaves the button hidden, by design — a
# button that cannot complete a sign-in is worse than no button.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
