DATABASE_URL="file:../../packages/db/prisma/dev.db"
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# "Sign in with LinkedIn" (Phase 12). Optional: leave both empty and the button
# is not drawn, while email and Google sign-in work unchanged.
#
# To fill them in: create an application at https://www.linkedin.com/developers/apps/new,
# associate it with a LinkedIn Page and have that Page's super administrator approve
# the association, then enable the "Sign in with LinkedIn using OpenID Connect"
# product on the Products tab. That product is self-serve and needs no review.
#
# Register the return addresses on the Auth tab, exactly. One per address the
# app is reached at; a registered address that does not match the one the app
# sends produces a button that appears and then fails. Registered 2026-08-08,
# covering all three applications that offer the button, local and deployed:
#   http://localhost:3001/api/auth/callback/linkedin              <- this app, local
#   http://localhost:3002/api/auth/callback/linkedin              <- meetings, local
#   http://localhost:3003/api/auth/callback/linkedin              <- sponsor, local
#   https://wbr-mobile.vercel.app/api/auth/callback/linkedin      <- this app, deployed
#   https://wbr-meetings.vercel.app/api/auth/callback/linkedin    <- meetings, deployed
#   https://wbr-sponsor.vercel.app/api/auth/callback/linkedin     <- sponsor, deployed
#   https://wbr-june-1220s-projects.vercel.app/api/auth/callback/linkedin
#   https://wbr-mobile-june-1220s-projects.vercel.app/api/auth/callback/linkedin
#
# A registered address is not enough on its own: the two values below must also
# be set on that deployment's own Vercel project, or the app registers no
# LinkedIn provider and draws no button.
#
# Both values must be set. One alone leaves the button hidden, by design — a
# button that cannot complete a sign-in is worse than no button.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
