DATABASE_URL="file:../../packages/db/prisma/dev.db"

# MUST be the same value as the attendee app's NEXTAUTH_SECRET.
#
# It signs this app's sessions, and it is also what the attendee app checks when
# this app tells it that cached data has changed (see ATTENDEE_APP_URL below).
# If the two differ, the attendee app answers {"error":"Invalid secret"} and
# every cache invalidation is refused. Measured 2026-08-02: the four apps on one
# development machine held three different values, so cross-app invalidation had
# never worked locally for any tag. Finding F-17.
NEXTAUTH_SECRET="run: openssl rand -base64 32"

NEXTAUTH_URL="http://localhost:3000"

# Where the attendee app lives, so this app can tell it that speakers, the floor
# plan or a sponsor's details have changed.
#
# Required in production. The attendee app deploys as its own Vercel project, so
# there is no shared origin to infer. Unset, this falls back to localhost:3001,
# which in production means the request goes nowhere: the organizer's save
# succeeds, the log carries a warning, and delegates keep stale data until the
# cache expires — up to five minutes for the venue map.
#
# Measured 2026-08-02: this variable was set on NO deployed project and appeared
# in no example file, which is why it was missed. Findings F-16 and F-17.
#
# Local: http://localhost:3001
# Production: the attendee app's own address, e.g. https://wbr-mobile.vercel.app
ATTENDEE_APP_URL="http://localhost:3001"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Documentation residue: no runtime code reads this. Admin access is decided by
# User.role. See apps/web/README.md § App-specific gotchas.
ADMIN_EMAILS="your@email.com"
