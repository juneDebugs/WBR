DATABASE_URL="file:../../packages/db/prisma/dev.db"

# MUST be the same value as the other three applications' NEXTAUTH_SECRET.
#
# It signs this portal's sessions. Four applications on one machine holding
# different values is a state this project has been in before — findings F-16
# and F-17 — and it fails quietly rather than loudly.
NEXTAUTH_SECRET="run: openssl rand -base64 32"

NEXTAUTH_URL="http://localhost:3002"

# "Sign in with LinkedIn" on this portal (UF-52). Optional: leave both empty and
# the button is not drawn, while email and Google sign-in work unchanged.
#
# The SAME developer application and the SAME two values as the participant app
# — copy them from apps/attendee/.env.local. One application, one set of
# credentials, one registered address per host it is reached at. The full setup
# instructions live in apps/attendee/.env.local.example.
#
# This portal's return addresses are registered there, both as of 2026-08-08:
#   http://localhost:3002/api/auth/callback/linkedin
#   https://wbr-meetings.vercel.app/api/auth/callback/linkedin
#
# The deployed portal still needs the two values below set on its own Vercel
# project. Without them it registers no LinkedIn provider and draws no button,
# which is the designed behaviour rather than a fault.
#
# WHAT THIS PORTAL DOES WITH A FIRST-TIME PERSON. It admits general attendees, so
# someone with no account here is created, admitted, and met by the onboarding
# checklist. That is the new-participant journey this portal did not have before.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
