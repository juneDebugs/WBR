    "test:chat-no-dm:api": "node scripts/test-admin-chat-dm-removed-api.mjs",
    "test:chat-settings": "node scripts/test-chat-settings.mjs",
    "test:onboarding-policy": "node scripts/test-onboarding-policy.mjs",
    "test:floor-plan": "node scripts/test-floor-plan.mjs",
    "test:booth-card": "node scripts/test-booth-card-data.mjs",
    "test:chat-settings:api": "node scripts/test-chat-settings-api.mjs",
    "test:chat-perm": "node scripts/test-chat-permission-enforcement.mjs",
    "e2e:feed": "node scripts/e2e-home-feed.mjs",
    "db:migrate-scheduled": "node scripts/migrate-scheduled-messages.mjs",
    "db:migrate-chat-settings": "node scripts/migrate-chat-settings.mjs",
    "db:migrate-feed": "node scripts/migrate-feed-social.mjs",
    "db:migrate-engine": "node scripts/migrate-meeting-engine.mjs",
    "db:migrate-priority": "node scripts/migrate-meeting-priority.mjs",
    "db:migrate-checkin": "node scripts/migrate-checkin.mjs",
    "db:migrate-auto-match": "node scripts/migrate-auto-match.mjs",
    "db:migrate-meeting-requirements": "node scripts/migrate-meeting-requirements.mjs",
    "db:migrate-meeting-tables": "node scripts/migrate-meeting-tables.mjs",
    "db:migrate-sponsor-tables": "node scripts/migrate-sponsor-tables.mjs",
    "db:migrate-floor-plan": "node scripts/migrate-floor-plan.mjs",
    "db:migrate-exclusive-slots": "node scripts/migrate-exclusive-slots.mjs",
    "db:migrate-exclusive-slot-indexes": "node scripts/migrate-exclusive-slot-indexes.mjs",
    "db:migrate-login-count": "node scripts/migrate-login-count.mjs",
