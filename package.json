    "test:checkin:api": "node scripts/test-checkin-api.mjs",
    "test:checkin-dashboard": "node scripts/test-checkin-dashboard.mjs",
    "e2e:checkin": "node scripts/e2e-checkin.mjs",
    "test:auto-match": "node scripts/test-auto-match.mjs",
    "test:meetings-perf": "node scripts/test-meetings-perf.mjs",
    "test:auto-match:api": "node scripts/test-auto-match-api.mjs",
    "e2e:auto-match": "node scripts/e2e-auto-match.mjs",
    "test:meeting-requirements": "node scripts/test-meeting-requirements.mjs",
    "test:meeting-requirements:api": "node scripts/test-meeting-requirements-api.mjs",
    "test:meeting-tables": "node scripts/test-meeting-tables.mjs",
    "test:meeting-tables:api": "node scripts/test-meeting-tables-api.mjs",
    "e2e:meeting-tables": "node scripts/e2e-meeting-tables.mjs",
    "test:sponsor-tables": "node scripts/test-sponsor-tables.mjs",
    "test:sponsor-tables:api": "node scripts/test-sponsor-tables-api.mjs",
    "test:meetings-log": "node scripts/test-meetings-log.mjs",
    "test:meetings-log:api": "node scripts/test-meetings-log-api.mjs",
    "e2e:meetings-log": "node scripts/e2e-meetings-log.mjs",
    "test:meetings-optimizations": "node scripts/test-meetings-optimizations.mjs",
    "test:audit-db": "node scripts/test-audit-db-regressions.mjs",
    "test:audit-security": "node scripts/test-audit-security.mjs",
    "test:audit": "node scripts/test-audit-db-regressions.mjs && node scripts/test-audit-security.mjs",
    "smoketest:browse": "node scripts/smoketest-browse-api.mjs",
    "test:scheduled": "node scripts/test-scheduled-messages.mjs",
    "test:scheduled:api": "node scripts/test-scheduled-messages-api.mjs",
    "test:feed": "node scripts/test-home-feed.mjs",
