    "db:sweep-auto-matches": "node scripts/sweep-auto-matches.mjs",
    "seed:feed-posts": "node scripts/seed-feed-posts.mjs",
    "seed:unscheduled": "node packages/db/scripts/seed-unscheduled-demo.mjs",
    "seed:auto-matches": "node scripts/seed-auto-matches.mjs",
    "seed:meeting-locations": "node scripts/seed-meeting-locations.mjs",
    "seed:floor-plan": "node scripts/seed-floor-plan.mjs",
    "build:floor-plan-maps": "node scripts/build-floor-plan-maps.mjs",
    "db:reset-test-accounts": "node packages/db/scripts/reset-test-accounts.mjs",
    "test:accounts": "node scripts/test-test-accounts.mjs",
    "e2e:accounts": "node scripts/e2e-app-access-all.mjs",
    "db:backfill-onboarding": "node packages/db/scripts/backfill-onboarding-required-fields.mjs",
    "test:canonical-restore": "pnpm --filter @conference/db test:canonical-restore",
    "test:sponsor-gate-demo": "pnpm --filter @conference/db test:sponsor-gate-demo"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "prisma": "^5.22.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
